# Copy to `.dev.vars` (git-ignored) and fill in before running `npm run dev`.
#
# Without MONGODB_URI the app still runs: the Worker falls back to Durable Object
# storage so you can walk the whole participant journey locally before Atlas exists.

MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="chameleon_study"

# Pepper for the email hash. Generate a long random value and never change it during
# data collection: changing it makes every previously stored hash unmatchable, which
# would silently disable duplicate control.
EMAIL_HASH_SALT="replace-with-a-long-random-string"

# Bearer token for /api/admin/*. Generate a long random value.
ADMIN_TOKEN="replace-with-a-long-random-string"
